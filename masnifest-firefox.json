{
  "manifest_version": 3,
  "name": "CT Attendance Calculator by Surya Kiran",
  "version": "6.7",
  "description": "Attendance calculator cuz i was too lazy to do it manually (By Surya Kiran)",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.codetantra.com/*"
  ],
  "action": {}, 
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.codetantra.com/*"],
      "js": ["content.js"]
    }
  ],
"browser_specific_settings": {
    "gecko": {
      "id": "attendance-calc@codetantra.extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}