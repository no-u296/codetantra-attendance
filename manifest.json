{
  "manifest_version": 3,
  "name": "CT Attendance Calculator",
  "version": "6.7.1",
  "description": "Attendance calculator cuz i was too lazy to do it manually",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://*.codetantra.com/*"],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.codetantra.com/*"],
      "js": ["content.js"]
    }
  ]
}
