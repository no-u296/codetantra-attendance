{
  "manifest_version": 3,
  "name": "CT Attendance",
  "version": "2.0",
  "description": "Attendance tracker for CodeTantra — IIITB",
  "permissions": ["notifications", "storage", "alarms", "scripting"],
  "host_permissions": ["*://*.codetantra.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.codetantra.com/*"],
      "js": ["content.js"]
    }
  ]
}
